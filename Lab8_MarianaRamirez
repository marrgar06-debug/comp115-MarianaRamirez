
Exercise 1 (20 marks: doctring: 5 marks, function implementation: 10 marks, unit tests: 5 marks)

def remove_duplicates_set(s):
    """
    This function removes the duplicates from the string s using a set.
    E.g.,
    >>> remove_duplicates("Apple")
    "Aple"
    
    """
    seen_set = set()
    res = ""
    for c in s:
        if c not in seen_set:
            res += c
            seen_set.add(c)
    return res

assert remove_duplicates_set("apple") == "aple"
assert remove_duplicates_set("strawberry") == "strawbey"


Exercise 2 (20 marks - doctring: 5 marks, function implementation: 10 marks, unit tests: 5 marks)

def gem_counting(stones, gems):
    """
    This function counts how many characters in "stones" are also present in the "gems" string
    E.g.,
    >>> gem_counting("abDFMdm", "admMQq")
    4
    Parameters: 
    - stones (str): A string representing the types of stones collected.
    - gems (str): A string representing the types of stones that are gems 
    
    Returns: 
    The total count of stones that are also gems as an integer 
    """
    gem_set = set(gems)
    gem_count = 0
    for stone in stones:
        if stone in gem_set:
            gem_count += 1
            
    return gem_count

assert gem_counting("abDFMdm", "admMQq") == 4
assert gem_counting("abDFMdm", "af") == 1
assert gem_counting("awCcM", "cQqW") == 1
assert gem_counting("bFfL", "cQqW") == 0

